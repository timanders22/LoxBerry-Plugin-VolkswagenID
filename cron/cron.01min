#!/bin/sh
# Volkswagen ID - Waechter, minuetlich.
# Startet den Dienst neu, wenn er laufen soll, aber nicht laeuft.
# Den bin-Pfad des Plugins setzt der Installer in der Befehlszeile unten ein.
# Der Platzhalter steht bewusst NUR dort: der Installer ersetzt ihn in der
# ganzen Datei, auch in einem Kommentar (am Geraet gesehen 17.09.2026).
#
# Seit 0.9.33 (Gruppe 41, Bauvorschrift G2) als ERSTE Anweisung der Waechter der
# Befehlsbruecke (Muster Matter2Lox 0.9.45, AudiConnect 0.9.30): startet sie nach Boot
# und Update spaetestens nach einer Minute, wenn "Befehle ueber MQTT annehmen" gesetzt
# ist, und haelt sie sonst an (nie waehrend einer Aktualisierung, hoechstens alle 600 s
# ein Neustart). Kein Start in den Hakenskripten. Ausgabe nach /dev/null: die Bruecke
# protokolliert selbst. Der Dienstwaechter schreibt seine Fehlerausgabe seit 0.9.33
# nach cron.err neben dem Protokoll (Regeln/03); erst den Ordner anlegen und die Datei
# anfassen - log/plugins liegt auf der RAM-Platte und kann fehlen.
# Upgrade-Marke (Regeln/06, Entscheidung des Hausherrn 18.11.2026, Frage 60; Bauart Renault-NG 2.1.37):
# waehrend einer Aktualisierung ruht dieser Takt. preupgrade.sh legt die Marke neben dem Datenordner
# mit der Unixzeit an, postinstall.sh oder postupgrade.sh entfernt sie. Ist sie juenger als 3600 s,
# endet der Takt hier still, vor jedem Schreiben. Eine Marke, die 3600 s oder aelter ist, in der Zukunft
# liegt oder keine Unixzeit enthaelt, gilt nicht - eine abgebrochene Aktualisierung legt den Takt nicht
# fuer immer still. Liefert die Uhr keine Zahl, gilt die Marke (geschlossen ausfallen).
UPGM_MARKE="REPLACELBPDATADIR.upgrade_laeuft"
if [ -f "$UPGM_MARKE" ]; then
    upgm_jetzt=$(date +%s 2>/dev/null); upgm_seit=$(cat "$UPGM_MARKE" 2>/dev/null)
    case "$upgm_seit" in ''|*[!0-9]*) upgm_seit=0 ;; esac
    case "$upgm_jetzt" in ''|*[!0-9]*|0) exit 0 ;; esac
    if [ "$upgm_seit" -le "$upgm_jetzt" ] && [ $((upgm_jetzt - upgm_seit)) -lt 3600 ]; then exit 0; fi
fi

BBSH="REPLACELBPBINDIR/befehlsbruecke.sh"
[ -f "$BBSH" ] && /bin/bash "$BBSH" waechter >/dev/null 2>&1
mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
ERR="REPLACELBPLOGDIR/cron.err"
touch "$ERR" 2>/dev/null
# 0.9.35 (Nachzug 01.11.2026, Bauart Renault NG 2.1.23): ist die Fehlerdatei nicht schreibbar, braeche die
# Umlenkung den Befehl ab, BEVOR er startet - bis 0.9.34 kein Lauf und keine Spur. Dann geht die Fehlerausgabe
# nach /dev/null, und der Lauf findet statt.
[ -f "$ERR" ] && [ -w "$ERR" ] || ERR=/dev/null
"REPLACELBPBINDIR/dienst.sh" waechter >/dev/null 2>>"$ERR"
