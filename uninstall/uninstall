#!/bin/bash
# Volkswagen ID - uninstall
# command <TEMPFOLDER> <NAME> <FOLDER> <VERSION> <BASEFOLDER>
#
# Laeuft als root beim Deinstallieren.
#
# ===================================================================
# WARUM ES DIESE DATEI GIBT
# ===================================================================
#
# LoxBerry raeumt beim Deinstallieren die Ordner weg, die dem Plugin
# gehoeren: bin/, data/, log/, config/, templates/ und die beiden
# webfrontend-Ordner. Die virtuelle Python-Umgebung liegt in
# bin/plugins/<ordner>/venv und geht damit mit.
#
# Zwei Dinge liegen AUSSERHALB dieser Ordner:
#
#   1. Die Sicherungsdateien
#        config/plugins/<ordner>.backup.vw.json
#        config/plugins/<ordner>.backup.zugang.json
#      Sie liegen bewusst neben dem Konfigordner, damit sie ein Update
#      und sogar eine Neuinstallation ueberstehen (preupgrade.sh legt
#      sie an, postinstall.sh spielt sie zurueck). Beim Deinstallieren
#      ist genau das falsch: in zugang.json stehen E-Mail, Passwort und
#      S-PIN des Volkswagen-Kontos. Die Datei ist nicht umsonst mit
#      0600 angelegt. Wer das Plugin entfernt, erwartet nicht, dass
#      seine Zugangsdaten auf der Karte bleiben.
#
#      Anmerkung zu einer verbreiteten Sorge: LoxBerry loescht beim
#      Deinstallieren config/plugins/<ordner>/ - also das VERZEICHNIS.
#      Eine Datei namens <ordner>.backup.vw.json liegt daneben, nicht
#      darin, und bliebe ohne dieses Skript liegen.
#
#   2. Der laufende Dienst. Er wird mit nohup gestartet und haengt an
#      keinem Elternprozess, den LoxBerry beenden wuerde.
#
# MQTT wird aufgeraeumt (ab 0.9.20, Entscheidung des Hausherrn 17.09.2026).
# Ist die MQTT-Ausgabe eingeschaltet, sendet der Dienst Zustaende mit
# "retain"; diese Themen blieben sonst nach dem Deinstallieren im Broker
# stehen. Bis 0.9.19 stand hier, der Dienst sende nur mit "publish" - das
# war seit Einfuehrung des Hakens "Werte im Broker behalten" falsch.

ARGV3=$3
ARGV5=$5
PFOLDER="${ARGV3:-volkswagenid}"
BASE="${ARGV5:-$LBHOMEDIR}"
# Dritter Rueckfall: der eigene Ablageort. Bewusst kein fest verdrahteter
# Systempfad - LoxBerry laesst sich anderswohin installieren, und der
# Plugin-Pruefer sucht die Zeichenkette, ohne den Zusammenhang zu sehen.
# Der Installer legt dieses Skript als <home>/data/system/uninstall/<ordner>
# ab und ruft es mit dem LoxBerry-Wurzelordner als fuenftem Argument auf
# (sbin/plugininstall.pl:1158 und :1577, am Geraet nachgesehen 17.09.2026).
# Bis 0.9.19 nannte dieser Kommentar data/plugins/<ordner>/uninstall/, und
# der Rueckfall ging vier Ebenen hinauf - vom wirklichen Ablageort aus ergab
# das den Ordner UEBER dem LoxBerry statt des LoxBerry selbst. Erreicht wird
# der Zweig nur ohne $5 und
# ohne $LBHOMEDIR.
if [ -z "$BASE" ] || [ ! -d "$BASE" ]; then
    BASE=$(cd "$(dirname "$(readlink -f "$0")")/../../.." 2>/dev/null && pwd)
fi

PDATA="$BASE/data/plugins/$PFOLDER"
PBIN="$BASE/bin/plugins/$PFOLDER"
PCONFIG="$BASE/config/plugins"

# ---------------------------------------------------------------
# 1. Dienst anhalten
# ---------------------------------------------------------------
# Geprueft wird ARGUMENTWEISE: /proc/<pid>/cmdline trennt die Argumente
# mit Nullbytes. Das zweite Argument muss genau unser Skript sein, das
# erste ein Python - "nano <pfad>/vw.py" fuehrt den vollen Pfad sonst
# ebenfalls als zweites Argument. Der volle Pfad statt nur des
# Dateinamens, damit die Deinstallation des einen Exemplars nicht den
# Dienst eines zweiten abschiesst (LoxBerry haengt bei Namenskonflikt
# 01, 02 ... an den Ordnernamen an).
#
# Gleichlautend mit preupgrade.sh und bin/dienst.sh dieser Fassung. Bis
# 0.9.22 fehlten hier drei Dinge, alle in WSL gemessen
# (Pruefung-VolkswagenID-0.9.22):
#   1. das DRITTE Argument. Ohne diese Bedingung gilt jeder Einmallauf als
#      Dienst - und dieses Skript ruft weiter unten selbst einen auf
#      (vw.py --mqtt-leeren). FALL 9: ein --selbsttest, dessen Nummer in der
#      PID-Datei stand, war nach der Deinstallation tot.
#   2. der BENUTZER. Der zweite Durchgang ueber /proc lief ungefiltert.
#   3. die Pruefung vor dem HARTEN Signal. beenden() schickte kill -9 auf
#      eine Nummer, die es zehn Sekunden zuvor geprueft hatte; in dieser
#      Zeit kann der Prozess enden und die Nummer neu vergeben werden.
#
# Wurde der Dienst mit einem relativen Pfad gestartet, wird er ueber das
# Arbeitsverzeichnis des PROZESSES aufgeloest, nicht ueber das eigene. Ist
# /proc/<pid>/cwd nicht lesbar, faellt die Pruefung geschlossen aus.
PIDDATEI="$PDATA/dienst.pid"
VW_SKRIPT="$PBIN/vw.py"
VW_SKRIPT_R=$(readlink -f "$VW_SKRIPT" 2>/dev/null)
[ -n "$VW_SKRIPT_R" ] || VW_SKRIPT_R="$VW_SKRIPT"
VW_UID=$(id -u loxberry 2>/dev/null || id -u)

ist_unser_dienst() {
    [ -r "/proc/$1/cmdline" ] || return 1
    {
        IFS= read -r -d '' vw_a0 || return 1
        IFS= read -r -d '' vw_a1 || return 1
        case "${vw_a0##*/}" in python|python3|python3.*) ;; *) return 1 ;; esac
        if [ "$vw_a1" != "$VW_SKRIPT" ]; then
            case "$vw_a1" in
                /*) vw_voll="$vw_a1" ;;
                *)  vw_cwd=$(readlink -f "/proc/$1/cwd" 2>/dev/null)
                    [ -n "$vw_cwd" ] || return 1
                    vw_voll="$vw_cwd/$vw_a1" ;;
            esac
            [ "$(readlink -f "$vw_voll" 2>/dev/null)" = "$VW_SKRIPT_R" ] || return 1
        fi
        IFS= read -r -d '' vw_a2 && return 1
        return 0
    } < "/proc/$1/cmdline"
}

# Alle eigenen Dienste, aufsteigend und ohne Dubletten. Zwei Quellen: die
# Suche ueber /proc findet auch einen Dienst OHNE PID-Datei (sie kann fehlen,
# wenn der Dienst von Hand gestartet oder die Datei geloescht wurde), die
# PID-Datei findet auch einen, der einem anderen Benutzer gehoert und deshalb
# durch den Benutzerfilter faellt.
vw_dienste() {
    {
        for vw_d in /proc/[0-9]*; do
            ist_unser_dienst "${vw_d#/proc/}" || continue
            [ "$(stat -c %u "$vw_d" 2>/dev/null)" = "$VW_UID" ] || continue
            echo "${vw_d#/proc/}"
        done
        vw_p=""
        [ -f "$PIDDATEI" ] && IFS= read -r vw_p < "$PIDDATEI" 2>/dev/null
        case "$vw_p" in
            ''|*[!0-9]*) ;;
            *) ist_unser_dienst "$vw_p" && echo "$vw_p" ;;
        esac
    } | sort -un
}

# Freundlich beenden, bis zu zehn Sekunden Zeit, dann hart - und vor JEDEM
# Signal wird neu gesucht, auch vor dem kill -9.
vw_dienste_beenden() {
    vw_ziel=$(vw_dienste)
    [ -n "$vw_ziel" ] || return 0
    kill $vw_ziel 2>/dev/null
    vw_i=0
    while [ $vw_i -lt 10 ] && [ -n "$(vw_dienste)" ]; do
        sleep 1
        vw_i=$((vw_i + 1))
    done
    vw_rest=$(vw_dienste)
    [ -n "$vw_rest" ] && kill -9 $vw_rest 2>/dev/null
    echo $vw_ziel
}

# Eine Nummer, die NICHT dem Abrufdienst gehoert, wird GENANNT, nicht beendet
# - ein fremder Vorgang mit wiederverwendeter Nummer ebenso wie ein
# Einmallauf dieses Plugins.
if [ -f "$PIDDATEI" ]; then
    VW_P=$(cat "$PIDDATEI" 2>/dev/null)
    if [ -n "$VW_P" ] && kill -0 "$VW_P" 2>/dev/null && ! ist_unser_dienst "$VW_P"; then
        echo "<INFO> Die Nummer $VW_P aus der PID-Datei gehoert nicht dem"
        echo "<INFO> Abrufdienst - es wurde nichts beendet."
    fi
fi

VW_BEENDET=$(vw_dienste_beenden)
if [ -n "$VW_BEENDET" ]; then
    echo "<OK> Laufenden Abrufdienst beendet (PID $VW_BEENDET)."
else
    echo "<INFO> Es lief kein Abrufdienst."
fi
rm -f "$PIDDATEI" "$PDATA/soll_laufen" 2>/dev/null
# Die Zuordnung Fahrgestellnummer -> Fahrzeugnummer liegt NEBEN dem
# Datenordner und wird vom Loeschblock des Installers nicht erfasst.
# Jede Zweitschrift, die entsteht, steht hier - sonst bleibt sie liegen.
rm -f "$BASE/data/plugins/$PFOLDER.nummern.json" 2>/dev/null

# ---------------------------------------------------------------
# 1b. Behaltene MQTT-Themen leeren
# ---------------------------------------------------------------
# NACH dem Anhalten des Dienstes - sonst schriebe er die Werte gleich
# wieder hinein - und VOR Schritt 2b, der vw.json ueberschreibt: darin steht
# das Themenpraefix. Die virtuelle Umgebung ist hier noch da; der Installer
# loescht bin/plugins/<ordner> erst nach diesem Skript (plugininstall.pl,
# purge_installation Schritt 7; am Geraet nachgesehen 17.09.2026).
# Als loxberry, nicht als root: gebraucht wird nur Lesezugriff auf die
# Konfiguration und auf general.json.
if [ -x "$PBIN/venv/bin/python3" ] && [ -f "$PBIN/vw.py" ]; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "PYTHONDONTWRITEBYTECODE=1 timeout 60 $(printf '%q ' "$PBIN/venv/bin/python3" "$PBIN/vw.py") --mqtt-leeren" 2>&1 || true
    else
        PYTHONDONTWRITEBYTECODE=1 timeout 60 "$PBIN/venv/bin/python3" "$PBIN/vw.py" --mqtt-leeren 2>&1 || true
    fi
else
    echo "<INFO> Die Python-Umgebung fehlt - behaltene MQTT-Themen wurden nicht geleert."
fi

# ---------------------------------------------------------------
# 2. Sicherungsdateien ausserhalb der Plugin-Ordner
# ---------------------------------------------------------------
for f in vw.json zugang.json; do
    BK="$PCONFIG/$PFOLDER.backup.$f"
    if [ -f "$BK" ]; then
        # Ueberschreiben, dann entfernen: nur unlink liesse den Inhalt
        # auf der Karte stehen, bis der Platz neu vergeben wird.
        LAENGE=$(stat -c %s "$BK" 2>/dev/null || echo 0)
        [ "$LAENGE" -gt 0 ] && dd if=/dev/zero of="$BK" bs=1 count="$LAENGE" \
            conv=notrunc >/dev/null 2>&1
        rm -f "$BK" && echo "<OK> Sicherung entfernt: $PFOLDER.backup.$f"
    fi
done

# ---------------------------------------------------------------
# 2b. Die LEBENDEN Geheimnisse, mit derselben Sorgfalt
# ---------------------------------------------------------------
#
# Bis 0.9.9 wurden nur die Zweitschriften ueberschrieben; zugang.json und
# token.json ueberliess das Skript dem purge_installation des LoxBerry, also
# einem einfachen rm. Das ist inkonsequent gegen die eigene Begruendung zwei
# Absaetze weiter oben - und die Meldung darunter behauptete mehr, als getan
# wurde. In token.json steht ein gueltiger Zugang zum Konto, auch ohne Passwort.
GELOESCHT=0
# vw.json.kaputt gehoert dazu: es ist eine Kopie der Konfiguration und traegt
# damit das Aktionstoken. Eine Datei, die nur "kaputt" heisst, ist deshalb
# nicht harmlos.
for f in "$PCONFIG/$PFOLDER/zugang.json" "$PDATA/token.json" \
         "$PDATA/bibliothek_cache.json" "$PCONFIG/$PFOLDER/vw.json" \
         "$PCONFIG/$PFOLDER/vw.json.kaputt"; do
    if [ -f "$f" ]; then
        LAENGE=$(stat -c %s "$f" 2>/dev/null || echo 0)
        [ "$LAENGE" -gt 0 ] && dd if=/dev/zero of="$f" bs=1 count="$LAENGE" \
            conv=notrunc >/dev/null 2>&1
        rm -f "$f" && GELOESCHT=$((GELOESCHT + 1))
    fi
done
echo "<OK> $GELOESCHT Datei(en) mit Zugangsdaten oder Anmeldemarken ueberschrieben"
echo "<OK> und entfernt."
echo "<INFO> Die Zugangsdaten des Volkswagen-Kontos und die Anmeldemarken sind"
echo "<INFO> damit vom LoxBerry entfernt - ueberschrieben, nicht nur ausgetragen."

# ---------------------------------------------------------------
# 3. Hinweis auf das, was LoxBerry selbst wegraeumt
# ---------------------------------------------------------------
echo "<INFO> Die virtuelle Python-Umgebung ($PBIN/venv) wird mit dem"
echo "<INFO> bin-Ordner des Plugins entfernt - dafuer ist nichts zu tun."

# Ein Merker, der die Deinstallation ueberlebt, startet den Dienst bei
# einer spaeteren Installation ungefragt wieder.
rm -f "$BASE/config/plugins/$PFOLDER.lief_vorher"

exit 0
